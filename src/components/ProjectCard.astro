---
import { ProjectCarousel, type CarouselImage } from "./ProjectCarousel";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  href: string;
  images: CarouselImage[];
  gradient: string;
  priority?: boolean;
}

const { title, subtitle, description, href, images, gradient, priority = false } = Astro.props;
---

<article class="rounded-lg border border-base-border bg-base-bg overflow-hidden md:shadow-xl">
  <ProjectCarousel client:visible images={images} title={title} gradientFallback={gradient} priority={priority} />

  <div class="px-5 py-6 sm:px-8 sm:py-8 md:px-10">
    <h2 class="text-2xl sm:text-4xl md:text-display font-bold text-base-text mb-2">
      {title}
      {subtitle && <span class="text-base-text/40 ml-2 sm:ml-4 text-xl sm:text-3xl">{subtitle}</span>}
    </h2>

    <p class="text-lg text-base-text/70 leading-relaxed mb-6 max-w-2xl">{description}</p>

    <a href={href} class="inline-flex items-center gap-2 text-brand-green font-medium hover:gap-4 transition-all">
      <span>View Project</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</article>
