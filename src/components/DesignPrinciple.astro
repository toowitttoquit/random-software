---
interface Props {
  title: string;
  description: string;
  icon?: string;
  variant?: "default" | "highlighted";
}

const { title, description, icon, variant = "default" } = Astro.props;
const borderClass = variant === "highlighted" ? "border-brand-coral/50" : "border-base-border";
---

<div class={`not-prose p-4 md:p-6 border ${borderClass} rounded-lg hover:border-brand-green/50 transition-colors`}>
  {icon && <div class="text-3xl mb-4" aria-hidden="true">{icon}</div>}
  <h3 class="text-xl font-semibold text-base-text mb-3">{title}</h3>
  <p class="text-base-text/70 leading-relaxed">{description}</p>
</div>
