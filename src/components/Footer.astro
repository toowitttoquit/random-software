---
import { getProjectHref, getProjects } from "@/lib/projects";

const projects = await getProjects();
---

<footer class="border-t border-base-border mt-16 md:mt-30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-16">
    <div class="flex flex-col md:flex-row md:justify-between gap-8 md:gap-12">
      <div class="space-y-4">
        <a
          href="/"
          class="text-xl font-semibold text-base-text hover:text-brand-green"
        >
          Random Software
        </a>
        <p class="text-sm text-base-text/70 max-w-xs">
          Intentional tools and experiments for people who build.
        </p>
        <div class="flex gap-4">
          <a
            href="https://x.com/toowitttoquit"
            target="_blank"
            rel="noopener noreferrer"
            class="text-base-text/70 hover:text-brand-green transition-colors"
            aria-label="X (Twitter)"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          </a>
          <a
            href="https://www.linkedin.com/in/awittenberg17/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-base-text/70 hover:text-brand-green transition-colors"
            aria-label="LinkedIn"
          >
            <aedInIcon class="w-5 h-5" />
          </a>
          <a
            href="https://github.com/toowitttoquit"
            target="_blank"
            rel="noopener noreferrer"
            class="text-base-text/70 hover:text-brand-green transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
          </a>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-sm font-semibold text-base-text uppercase tracking-wider">
          Projects
        </h3>
        <ul class="space-y-2">
          {
            projects.map((project) => (
              <li>
                <a
                  href={getProjectHref(project)}
                  class="text-sm text-base-text/70 hover:text-brand-green transition-colors"
                >
                  {project.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-sm font-semibold text-base-text uppercase tracking-wider">
          More
        </h3>
        <ul class="space-y-2">
          <li>
            <a
              href="/manifesto"
              class="text-sm text-base-text/70 hover:text-brand-green transition-colors"
            >
              Manifesto
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-base-border">
      <p class="text-xs text-base-text/70">
        &copy; {new Date().getFullYear()} Random Software
      </p>
    </div>
  </div>
</footer>
