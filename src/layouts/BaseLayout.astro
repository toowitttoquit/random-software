---
import "@fontsource-variable/space-grotesk/index.css";
import "@/styles/globals.css";
import Footer from "@/components/Footer.astro";
import { Navigation } from "@/components/Navigation";
import { getProjectHref, getProjects } from "@/lib/projects";
import { DEFAULT_DESCRIPTION, SITE_NAME, formatPageTitle, getCanonicalUrl } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props;

const pageTitle = formatPageTitle(title);
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const galleryItems = (await getProjects()).map((project) => ({
  href: getProjectHref(project),
  label: project.data.navLabel,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <Navigation client:load galleryItems={galleryItems} />
    <slot />
    <Footer />
  </body>
</html>
