---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Vibecoding for Operators"
  description="Learn to build software that matters. A course for operators, founders, and non-engineers who want to create tools with intention."
>
<main class="min-h-screen bg-base-bg pt-24">
    <section class="max-w-4xl mx-auto px-6 py-20 text-center">
      <p class="text-sm uppercase tracking-wider text-brand-coral font-medium mb-4">
        Coming Soon
      </p>
      <h1 class="text-hero font-bold text-base-text mb-6">
        Vibecoding for Operators
      </h1>
      <p class="text-xl text-base-text/70 max-w-2xl mx-auto leading-relaxed mb-8">
        A course for founders, operators, and non-engineers who want to build
        software with intention—not obligation.
      </p>
      <a
        href="/manifesto"
        class="inline-flex items-center gap-2 text-brand-green hover:text-brand-green/80 font-medium"
      >
        Read the philosophy
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-16">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-6 border border-base-border rounded-lg">
          <div class="text-2xl mb-4">🎯</div>
          <h3 class="text-lg font-semibold text-base-text mb-2">
            Build for yourself first
          </h3>
          <p class="text-base-text/70 text-sm">
            Learn to identify problems worth solving and create tools that
            serve your actual workflow.
          </p>
        </div>
        <div class="p-6 border border-base-border rounded-lg">
          <div class="text-2xl mb-4">🛠️</div>
          <h3 class="text-lg font-semibold text-base-text mb-2">
            Practical AI-assisted development
          </h3>
          <p class="text-base-text/70 text-sm">
            Use modern AI tools to prototype and build without years of
            traditional coding experience.
          </p>
        </div>
        <div class="p-6 border border-base-border rounded-lg">
          <div class="text-2xl mb-4">💡</div>
          <h3 class="text-lg font-semibold text-base-text mb-2">
            Ship something real
          </h3>
          <p class="text-base-text/70 text-sm">
            By the end, you&apos;ll have built and deployed a working tool
            that solves a problem you actually have.
          </p>
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-16">
      <h2 class="text-h1 font-bold text-base-text mb-8 text-center">
        Who this is for
      </h2>
      <div class="space-y-4 max-w-2xl mx-auto">
        <div class="flex items-start gap-4">
          <span class="text-brand-green mt-1">✓</span>
          <p class="text-base-text/80">
            <strong>Operators and founders</strong> who have ideas for
            internal tools but no technical background
          </p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-brand-green mt-1">✓</span>
          <p class="text-base-text/80">
            <strong>Curious builders</strong> who want to understand how
            software works without becoming full-time engineers
          </p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-brand-green mt-1">✓</span>
          <p class="text-base-text/80">
            <strong>Anyone frustrated</strong> by off-the-shelf tools that
            almost-but-don&apos;t-quite fit their workflow
          </p>
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-20">
      <div class="bg-gradient-to-br from-brand-green/10 to-brand-coral/10 rounded-2xl p-12 text-center">
        <h2 class="text-display font-bold text-base-text mb-4">
          Get notified when we launch
        </h2>
        <p class="text-base-text/70 mb-8 max-w-lg mx-auto">
          The course is currently in development. Join the waitlist to be
          first to know when enrollment opens.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center max-w-md mx-auto">
          <input
            type="email"
            placeholder="your@email.com"
            class="flex-1 px-4 py-3 border border-base-border rounded-lg bg-base-bg text-base-text placeholder:text-base-text/40 focus:outline-none focus:ring-2 focus:ring-brand-green/50"
            disabled
          />
          <button
            class="px-6 py-3 bg-brand-green text-white font-medium rounded-lg opacity-50 cursor-not-allowed"
            disabled
          >
            Join Waitlist
          </button>
        </div>
        <p class="text-xs text-base-text/50 mt-4">
          Waitlist signup coming soon
        </p>
      </div>
    </section>

    <footer class="max-w-4xl mx-auto px-6 py-16 text-center border-t border-base-border mt-20">
      <p class="text-sm text-base-text/50">
        Built with Astro · Deployed on Vercel
      </p>
    </footer>
  </main>
</BaseLayout>
