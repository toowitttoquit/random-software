---
import ProjectCard from "@/components/ProjectCard.astro";
import ShineBorder from "@/components/ui/ShineBorder.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCarouselImages, getProjectHref, getProjects } from "@/lib/projects";

const projects = await Promise.all(
  (await getProjects()).map(async (project) => ({
    project,
    images: await getCarouselImages(project),
  })),
);
---

<BaseLayout>
  <main class="min-h-screen bg-base-bg pt-16 md:pt-24">
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-6 md:py-10 flex justify-center">
      <ShineBorder
        class="relative flex flex-col items-center justify-center overflow-hidden rounded-lg border border-base-border bg-base-bg px-6 py-14 sm:px-10 sm:py-20 md:px-20 md:py-24 md:shadow-xl"
        colors={["#00B140", "#FF6B5A"]}
        borderRadius={12}
      >
        <h1 class="text-3xl sm:text-5xl md:text-hero font-bold text-base-text mb-4 md:mb-6 text-center">
          The future of software is random.
        </h1>
        <p class="text-base md:text-xl text-base-text/70 max-w-2xl mx-auto leading-relaxed text-center">
          A portfolio of tools from a one-person team with ADHD, a long backlog of ideas &amp; a Claude Max
          subscription.
        </p>
      </ShineBorder>
    </section>

    <section id="work" class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-20 space-y-16 md:space-y-30">
      {
        projects.map(({ project, images }, index) => (
          <div id={project.id}>
            <ProjectCard
              title={project.data.title}
              subtitle={project.data.subtitle}
              description={project.data.description}
              href={getProjectHref(project)}
              images={images}
              gradient={project.data.gradient}
              priority={index === 0}
            />
          </div>
        ))
      }
    </section>
  </main>
</BaseLayout>
